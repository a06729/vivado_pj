/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"
#include "sleep.h"

#define AXI_SERVO_BASEADDR  0x00010000
#define GPIO_BTN0_DEVICE_ID     XPAR_GPIO_0_DEVICE_ID
#define BTN0_CHANNEL1          1
#define BTN0_INT_MSK            XGPIO_IR_CH1_MASK


XGpio GPIO_BTN;


int main()
{
    init_platform();
    xil_printf("Servo Control Start\r\n");

    // GPIO 초기화 + 방향 설정 (입력)
    XGpio_Initialize(&GPIO_BTN, GPIO_BTN0_DEVICE_ID);
    XGpio_SetDataDirection(&GPIO_BTN, BTN0_CHANNEL1, 0xFFFFFFFF);

    u32 sw_val;

    while(1) {
        // 한 번만 읽어서 변수에 저장
        sw_val = XGpio_DiscreteRead(&GPIO_BTN, BTN0_CHANNEL1);

        if      (sw_val & (1<<0)) Xil_Out32(AXI_SERVO_BASEADDR, 0);
        else if (sw_val & (1<<1)) Xil_Out32(AXI_SERVO_BASEADDR, 7);
        else if (sw_val & (1<<2)) Xil_Out32(AXI_SERVO_BASEADDR, 16);
        else if (sw_val & (1<<3)) Xil_Out32(AXI_SERVO_BASEADDR, 26);
        else                      Xil_Out32(AXI_SERVO_BASEADDR, 0); // 기본값

        usleep(10000); // 10ms 디바운스
    }

    cleanup_platform();


    return 0;
}
